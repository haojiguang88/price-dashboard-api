{
  "name": "price-dashboard-api",
  "version": "1.0.0",
  "description": "Price Dashboard API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run dev:business",
    "dev:business": "sh -c 'PORT=${PORT:-3001} BUSINESS_DB_PATH=${BUSINESS_DB_PATH:-./data/price_dashboard_business_dev.db} tsx watch src/index.ts'",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "verify:business-db": "tsx scripts/verify-business-database.ts",
    "setup:business-tasks": "sh -c '${TASK_CENTER_PYTHON:-python3} -m pip install -r requirements-business-tasks.txt'",
    "sync:online-prices": "python3 scripts/business/sync_online_price_records.py",
    "test:silver-assist": "tsx scripts/business/verify_silver_assist_evaluator.ts",
    "test:precious-metal-assist": "tsx scripts/business/verify_precious_metal_assist_evaluator.ts",
    "report:precious-metal-thresholds": "tsx scripts/business/calibrate_precious_metal_thresholds.ts",
    "report:precious-metal-cycle-context": "tsx scripts/business/precious_metal_cycle_context.ts",
    "start": "npm run start:business",
    "start:business": "sh -c 'NODE_ENV=${NODE_ENV:-production} PORT=${PORT:-3001} node dist/index.js'",
    "restart:local": "sh -c 'port=${PORT:-3001}; pid=$(lsof -tiTCP:$port -sTCP:LISTEN || true); if [ -n \"$pid\" ]; then kill $pid; fi; NODE_ENV=development DEPLOYMENT_MODE=local HOST=127.0.0.1 npm run start:business'"
  },
  "keywords": [
    "price",
    "dashboard",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^4.21.0",
    "pdf-parse": "^2.4.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  }
}
