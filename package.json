{
  "name": "price-dashboard-api",
  "version": "1.0.0",
  "description": "Price Dashboard API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run dev:business",
    "dev:business": "sh -c 'APP_WORKSPACE=business PORT=${PORT:-3001} BUSINESS_DB_PATH=${BUSINESS_DB_PATH:-/Volumes/7100/price-dashboard-data/db/price_dashboard_business_dev.db} tsx watch src/index.ts'",
    "build": "tsc",
    "start": "npm run start:business",
    "start:business": "sh -c 'APP_WORKSPACE=business PORT=${PORT:-3001} BUSINESS_DB_PATH=${BUSINESS_DB_PATH:-/Volumes/7100/price-dashboard-data/db/price_dashboard_business_dev.db} node dist/index.js'",
    "db:split-preview": "node scripts/database/split_database_preview.js",
    "db:split-validate": "node scripts/database/validate_split_preview.js",
    "db:prune-dry-run": "node scripts/database/generate_prune_dry_run.js",
    "db:workspace-center-table-dry-run": "node scripts/database/generate_workspace_center_table_boundary_dry_run.js",
    "db:split-pruned-copy": "node scripts/database/materialize_pruned_split_copies.js",
    "db:promote-pruned-rehearsal": "node scripts/database/rehearse_pruned_db_promotion.js",
    "restart:local": "sh -c 'port=${PORT:-3001}; pid=$(lsof -tiTCP:$port -sTCP:LISTEN || true); if [ -n \"$pid\" ]; then kill $pid; fi; npm run start:business'"
  },
  "keywords": [
    "price",
    "dashboard",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^4.21.0",
    "pdf-parse": "^2.4.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  }
}
