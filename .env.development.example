NODE_ENV=development
DEPLOYMENT_MODE=local
HOST=127.0.0.1
PORT=3001
APP_WORKSPACE=business
BUSINESS_DB_PATH=./data/price_dashboard_business_dev.db
ALLOW_DB_CREATE=false

# For an intentional first-time local database only, run once with ALLOW_DB_CREATE=true.
# Set it back to false after the file is created.

# Point task-center scripts to a Python that has requirements-business-tasks.txt installed.
# macOS launchd often resolves python3 differently from an interactive shell.
TASK_CENTER_PYTHON=.venv/bin/python

CORS_ORIGINS=http://localhost:5173
