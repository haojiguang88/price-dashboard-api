NODE_ENV=development
PORT=3001
APP_WORKSPACE=business
BUSINESS_DB_PATH=./data/price_dashboard_business_dev.db

# Point task-center scripts to a Python that has requirements-business-tasks.txt installed.
# macOS launchd often resolves python3 differently from an interactive shell.
TASK_CENTER_PYTHON=/Library/Developer/CommandLineTools/usr/bin/python3

CORS_ORIGINS=http://localhost:5173
