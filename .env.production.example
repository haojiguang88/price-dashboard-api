NODE_ENV=production
DEPLOYMENT_MODE=remote
HOST=127.0.0.1
PORT=3001
APP_WORKSPACE=business
BUSINESS_DB_PATH=/absolute/path/to/price_dashboard_business_prod.db
ALLOW_DB_CREATE=false

PUBLIC_BASE_URL=https://business.example.com
TRUST_PROXY=loopback
SERVER_AUTH_MODE=session
# Prefer session. If using trusted_reverse_proxy instead, also set:
# AUTH_IDENTITY_HEADER=X-Authenticated-User
# AUTH_PROXY_SHARED_SECRET=replace-with-at-least-32-random-characters
# AUTH_PROXY_SECRET_HEADER=X-Price-Dashboard-Proxy-Secret
# Local production (DEPLOYMENT_MODE=local) forbids auth none unless:
# ALLOW_UNAUTHENTICATED_LOCAL=true
AUTH_USERNAME=owner
# Run `npm run auth:hash-password` and paste the generated value.
AUTH_PASSWORD_HASH=scrypt-v1:replace-with-generated-salt:replace-with-generated-hash
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_HOURS=12

# Install with: npm run setup:business-tasks after TASK_CENTER_PYTHON is set.
TASK_CENTER_PYTHON=/absolute/path/to/price-dashboard-api/.venv/bin/python

CORS_ORIGINS=https://business.example.com
